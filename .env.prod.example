DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,.example.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://*.example.com
BASE_DOMAIN=example.com

DB_NAME=systemmanager
DB_USER=systemmanager
DB_PASSWORD=replace-with-a-unique-database-password

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
WEB_CONCURRENCY=3

# Reference USD/EUR feed, daily at 03:00 America/Bogota.
CURRENCY_AUTO_UPDATE=True
